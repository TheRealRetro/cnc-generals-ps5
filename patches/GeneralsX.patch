@@ -0,0 +1,347 @@
+/*
+**	Command & Conquer Generals(tm)
+**	Copyright 2025 Electronic Arts Inc.
+**
+**	This program is free software: you can redistribute it and/or modify
+**	it under the terms of the GNU General Public License as published by
+**	the Free Software Foundation, either version 3 of the License, or
+**	(at your option) any later version.
+**
+**	This program is distributed in the hope that it will be useful,
+**	but WITHOUT ANY WARRANTY; without even the implied warranty of
+**	MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+**	GNU General Public License for more details.
+**
+**	You should have received a copy of the GNU General Public License
+**	along with this program.  If not, see <http://www.gnu.org/licenses/>.
+*/
+
+/*
+** SDL3Gamepad.cpp
+**
+** GeneralsX @feature PS5 13/10/2026 A gamepad stands in for mouse and keyboard (see SDL3Gamepad.h).
+*/
+
+#ifndef _WIN32
+
+#include "SDL3Device/GameClient/SDL3Gamepad.h"
+
+#include "GameClient/LookAtXlat.h"
+
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+
+namespace {
+
+const float kStickDeadZone = 0.15f;
+const float kCursorScreensPerSecond = 1.1f; // full deflection: about one screen height a second
+const float kTriggerThreshold = 0.35f;
+const Uint64 kScanIntervalMs = 1000;
+
+// Buttons that press one key while held.
+struct ButtonKey
+{
+	SDL_GamepadButton button;
+	SDL_Scancode scancode;
+};
+
+const ButtonKey kButtonKeys[] = {
+	{ SDL_GAMEPAD_BUTTON_LEFT_SHOULDER, SDL_SCANCODE_LSHIFT },
+	{ SDL_GAMEPAD_BUTTON_RIGHT_SHOULDER, SDL_SCANCODE_LCTRL },
+	{ SDL_GAMEPAD_BUTTON_NORTH, SDL_SCANCODE_E },
+	{ SDL_GAMEPAD_BUTTON_WEST, SDL_SCANCODE_S },
+	{ SDL_GAMEPAD_BUTTON_DPAD_UP, SDL_SCANCODE_1 },
+	{ SDL_GAMEPAD_BUTTON_DPAD_RIGHT, SDL_SCANCODE_2 },
+	{ SDL_GAMEPAD_BUTTON_DPAD_DOWN, SDL_SCANCODE_3 },
+	{ SDL_GAMEPAD_BUTTON_DPAD_LEFT, SDL_SCANCODE_4 },
+	{ SDL_GAMEPAD_BUTTON_LEFT_STICK, SDL_SCANCODE_H },
+	{ SDL_GAMEPAD_BUTTON_RIGHT_STICK, SDL_SCANCODE_KP_5 },
+	{ SDL_GAMEPAD_BUTTON_TOUCHPAD, SDL_SCANCODE_SPACE },
+	{ SDL_GAMEPAD_BUTTON_START, SDL_SCANCODE_ESCAPE },
+};
+
+float axis(SDL_Gamepad *pad, SDL_GamepadAxis which)
+{
+	return SDL_GetGamepadAxis(pad, which) / 32767.0f;
+}
+
+} // namespace
+
+SDL3Gamepad::SDL3Gamepad()
+	: m_pad(nullptr),
+	  m_subsystemReady(false),
+	  m_nextScanMs(0),
+	  m_lastTicksNs(0),
+	  m_cursorX(0.0f),
+	  m_cursorY(0.0f),
+	  m_initFailureLogged(false),
+	  m_joysticksLogged(-1),
+	  m_inputSeen(false),
+	  m_traceAtMs(0)
+{
+	memset(m_buttons, 0, sizeof(m_buttons));
+	memset(m_keys, 0, sizeof(m_keys));
+}
+
+SDL3Gamepad::~SDL3Gamepad()
+{
+	close();
+}
+
+void SDL3Gamepad::open(void)
+{
+	int joysticks = 0;
+	SDL_free(SDL_GetJoysticks(&joysticks));
+	int count = 0;
+	SDL_JoystickID *ids = SDL_GetGamepads(&count);
+	if (joysticks != m_joysticksLogged)
+	{
+		fprintf(stderr, "INFO: Gamepad: SDL sees %d joystick(s), %d of them gamepads\n", joysticks, count);
+		m_joysticksLogged = joysticks;
+	}
+	if (ids != nullptr && count > 0)
+	{
+		m_pad = SDL_OpenGamepad(ids[0]);
+		if (m_pad != nullptr)
+		{
+			char *mapping = SDL_GetGamepadMapping(m_pad);
+			fprintf(stderr, "INFO: Gamepad: opened %s (%s)\n", SDL_GetGamepadName(m_pad), mapping ? mapping : "no mapping");
+			SDL_free(mapping);
+			SDL_SetGamepadLED(m_pad, 255, 150, 0);
+		}
+		else
+		{
+			fprintf(stderr, "WARNING: Gamepad: SDL_OpenGamepad failed: %s\n", SDL_GetError());
+		}
+	}
+	SDL_free(ids);
+}
+
+void SDL3Gamepad::trace(SDL_Window *window)
+{
+	const float lx = axis(m_pad, SDL_GAMEPAD_AXIS_LEFTX);
+	const float ly = axis(m_pad, SDL_GAMEPAD_AXIS_LEFTY);
+	const float rx = axis(m_pad, SDL_GAMEPAD_AXIS_RIGHTX);
+	const float ry = axis(m_pad, SDL_GAMEPAD_AXIS_RIGHTY);
+	Uint32 buttons = 0;
+	for (int button = 0; button < SDL_GAMEPAD_BUTTON_COUNT && button < 32; ++button)
+	{
+		buttons |= SDL_GetGamepadButton(m_pad, (SDL_GamepadButton)button) ? (1u << button) : 0u;
+	}
+	const bool input = buttons != 0 || SDL_fabsf(lx) > kStickDeadZone || SDL_fabsf(ly) > kStickDeadZone ||
+		SDL_fabsf(rx) > kStickDeadZone || SDL_fabsf(ry) > kStickDeadZone;
+	const Uint64 now = SDL_GetTicks();
+	if ((input && !m_inputSeen) || (now >= m_traceAtMs && now < 180000))
+	{
+		int width = 0;
+		int height = 0;
+		SDL_GetWindowSize(window, &width, &height);
+		fprintf(stderr, "INFO: Gamepad:%s sticks %+.2f %+.2f / %+.2f %+.2f, buttons %#x, cursor %.0f,%.0f in %dx%d, keyboard focus %s\n",
+			input && !m_inputSeen ? " first input," : "", lx, ly, rx, ry, (unsigned)buttons, m_cursorX, m_cursorY,
+			width, height, SDL_GetKeyboardFocus() == window ? "yes" : "no");
+		m_traceAtMs = now + 5000;
+	}
+	m_inputSeen = m_inputSeen || input;
+}
+
+void SDL3Gamepad::close(void)
+{
+	if (m_pad != nullptr)
+	{
+		SDL_CloseGamepad(m_pad);
+		m_pad = nullptr;
+	}
+}
+
+void SDL3Gamepad::pushMouseButton(SDL_Window *window, Uint8 button, bool down)
+{
+	SDL_Event event;
+	SDL_zero(event);
+	event.type = down ? SDL_EVENT_MOUSE_BUTTON_DOWN : SDL_EVENT_MOUSE_BUTTON_UP;
+	event.button.timestamp = SDL_GetTicksNS();
+	event.button.windowID = SDL_GetWindowID(window);
+	event.button.button = button;
+	event.button.down = down;
+	event.button.clicks = 1;
+	event.button.x = m_cursorX;
+	event.button.y = m_cursorY;
+	SDL_PushEvent(&event);
+}
+
+void SDL3Gamepad::pushKey(SDL_Window *window, SDL_Scancode scancode, bool down)
+{
+	SDL_Event event;
+	SDL_zero(event);
+	event.type = down ? SDL_EVENT_KEY_DOWN : SDL_EVENT_KEY_UP;
+	event.key.timestamp = SDL_GetTicksNS();
+	event.key.windowID = SDL_GetWindowID(window);
+	event.key.scancode = scancode;
+	event.key.key = SDL_GetKeyFromScancode(scancode, SDL_KMOD_NONE, false);
+	event.key.mod = SDL_GetModState();
+	event.key.down = down;
+	SDL_PushEvent(&event);
+}
+
+// Press or release a key, once per change. Held modifiers also go into SDL's modifier state,
+// which events and SDL_GetModState() report.
+void SDL3Gamepad::setKey(SDL_Window *window, SDL_Scancode scancode, bool down)
+{
+	if (m_keys[scancode] == down)
+	{
+		return;
+	}
+	m_keys[scancode] = down;
+
+	SDL_Keymod modifier = SDL_KMOD_NONE;
+	if (scancode == SDL_SCANCODE_LSHIFT) modifier = SDL_KMOD_LSHIFT;
+	if (scancode == SDL_SCANCODE_LCTRL) modifier = SDL_KMOD_LCTRL;
+	if (modifier != SDL_KMOD_NONE)
+	{
+		const SDL_Keymod mods = SDL_GetModState();
+		SDL_SetModState(down ? (SDL_Keymod)(mods | modifier) : (SDL_Keymod)(mods & ~modifier));
+	}
+	pushKey(window, scancode, down);
+}
+
+void SDL3Gamepad::releaseAll(SDL_Window *window)
+{
+	if (m_buttons[SDL_GAMEPAD_BUTTON_SOUTH]) pushMouseButton(window, SDL_BUTTON_LEFT, false);
+	if (m_buttons[SDL_GAMEPAD_BUTTON_EAST]) pushMouseButton(window, SDL_BUTTON_RIGHT, false);
+	for (int scancode = 0; scancode < SDL_SCANCODE_COUNT; ++scancode)
+	{
+		setKey(window, (SDL_Scancode)scancode, false);
+	}
+	memset(m_buttons, 0, sizeof(m_buttons));
+	if (TheLookAtTranslator != nullptr)
+	{
+		TheLookAtTranslator->setStickScroll(0.0f, 0.0f);
+	}
+}
+
+void SDL3Gamepad::moveCursor(SDL_Window *window, float dt)
+{
+	int width = 0;
+	int height = 0;
+	SDL_GetWindowSize(window, &width, &height);
+	if (width <= 0 || height <= 0)
+	{
+		return;
+	}
+
+	const float x = axis(m_pad, SDL_GAMEPAD_AXIS_LEFTX);
+	const float y = axis(m_pad, SDL_GAMEPAD_AXIS_LEFTY);
+	const float magnitude = std::sqrt(x * x + y * y);
+	if (magnitude < kStickDeadZone)
+	{
+		// Follow a real mouse while the stick rests, so the two never fight.
+		SDL_GetMouseState(&m_cursorX, &m_cursorY);
+		return;
+	}
+
+	// Past the dead zone, speed grows with the square of the deflection: fine aim near the centre.
+	const float scaled = (magnitude - kStickDeadZone) / (1.0f - kStickDeadZone);
+	const float speed = scaled * scaled * kCursorScreensPerSecond * (float)height;
+	m_cursorX += x / magnitude * speed * dt;
+	m_cursorY += y / magnitude * speed * dt;
+	m_cursorX = SDL_clamp(m_cursorX, 0.0f, (float)(width - 1));
+	m_cursorY = SDL_clamp(m_cursorY, 0.0f, (float)(height - 1));
+	SDL_WarpMouseInWindow(window, m_cursorX, m_cursorY);
+}
+
+// The right stick scrolls the map through the camera's own scrolling, at up to the keyboard scroll
+// speed. (The arrow keys would not do: in a game they cycle through units.)
+void SDL3Gamepad::scroll(void)
+{
+	if (TheLookAtTranslator == nullptr)
+	{
+		return;
+	}
+	const float x = axis(m_pad, SDL_GAMEPAD_AXIS_RIGHTX);
+	const float y = axis(m_pad, SDL_GAMEPAD_AXIS_RIGHTY);
+	const float magnitude = std::sqrt(x * x + y * y);
+	if (magnitude < kStickDeadZone)
+	{
+		TheLookAtTranslator->setStickScroll(0.0f, 0.0f);
+		return;
+	}
+	const float scaled = SDL_min((magnitude - kStickDeadZone) / (1.0f - kStickDeadZone), 1.0f);
+	const float speed = scaled * scaled;
+	TheLookAtTranslator->setStickScroll(x / magnitude * speed, y / magnitude * speed);
+}
+
+void SDL3Gamepad::update(SDL_Window *window)
+{
+	if (window == nullptr)
+	{
+		return;
+	}
+	if (!m_subsystemReady)
+	{
+		m_subsystemReady = SDL_InitSubSystem(SDL_INIT_GAMEPAD);
+		if (!m_subsystemReady)
+		{
+			if (!m_initFailureLogged)
+			{
+				fprintf(stderr, "WARNING: Gamepad: SDL's gamepad support did not start: %s\n", SDL_GetError());
+				m_initFailureLogged = true;
+			}
+			return;
+		}
+		fprintf(stderr, "INFO: Gamepad: SDL's gamepad support started\n");
