new file mode 100644
index 000000000..2aa3304fa
--- /dev/null
+++ b/Core/GameEngineDevice/Include/MiniAudioDevice/MiniAudioPS5Backend.h
@@ -0,0 +1,206 @@
+/*
+**	Command & Conquer Generals(tm)
+**	Copyright 2025 Electronic Arts Inc.
