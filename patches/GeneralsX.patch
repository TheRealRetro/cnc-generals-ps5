+/*
+** SDL3Gamepad.h
+**
+** GeneralsX @feature PS5 13/10/2026 Play with a gamepad (the PS5's DualSense).
+**
+** The game is driven by mouse and keyboard. A gamepad stands in for both: each update reads the
+** first connected gamepad and pushes the mouse and keyboard events it means into SDL's queue,
+** where SDL3GameEngine hands them to SDL3Mouse and SDL3Keyboard like any others. A USB mouse and
+** keyboard keep working beside it.
+**
+**   left stick      cursor              right stick   scroll the map (LookAtTranslator)
+**   cross / circle  left / right click  L1 / R1 held  Shift / Ctrl
+**   L2 / R2         zoom out / in       D-pad         control groups 1-4 (with R1: assign)
+**   triangle        select matching (E) square        stop (S)
+**   L3              command centre (H)  R3            reset camera (keypad 5)
+**   touch pad       last radar event    options       menu (Esc)
+*/
+
+#pragma once
+
+#ifndef _WIN32
+
+#include <SDL3/SDL.h>
+
+class SDL3Gamepad
+{
+public:
+	SDL3Gamepad();
+	~SDL3Gamepad();
+
+	/// Read the gamepad and push the mouse and keyboard events it stands for. Call once per frame,
+	/// before the event queue is drained.
+	void update(SDL_Window *window);
+
+private:
+	void open(void);
+	void close(void);
+	void releaseAll(SDL_Window *window);
+	void moveCursor(SDL_Window *window, float dt);
+	void scroll(void);
+	void pushMouseButton(SDL_Window *window, Uint8 button, bool down);
+	void pushKey(SDL_Window *window, SDL_Scancode scancode, bool down);
+	void setKey(SDL_Window *window, SDL_Scancode scancode, bool down);
+
+	SDL_Gamepad *m_pad;
+	bool m_subsystemReady;
+	Uint64 m_nextScanMs;
+	Uint64 m_lastTicksNs;
+	float m_cursorX;
+	float m_cursorY;
+	bool m_buttons[SDL_GAMEPAD_BUTTON_COUNT];
+	bool m_keys[SDL_SCANCODE_COUNT];
+
+	// What the log says: SDL's start, the joysticks it sees, the first input, and a periodic snapshot.
+	void trace(SDL_Window *window);
+	bool m_initFailureLogged;
+	int m_joysticksLogged;
+	bool m_inputSeen;
+	Uint64 m_traceAtMs;
+};
+
+#endif // !_WIN32
