+/**
+ * A cursor frame as an image for the game's 2D renderer: an A8R8G8B8 texture holding the frame's
+ * pixels, wrapped in a raw-texture Image as W3DRadar wraps its textures. Made on first use.
+ */
+static const Image *consoleCursorImage(AnimatedCursor *cursor, int frameIndex)
+{
+	if (cursor->m_frameImages[frameIndex] != nullptr)
+	{
+		return cursor->m_frameImages[frameIndex];
+	}
+	SDL_Surface *frame = cursor->m_frameSurfaces[frameIndex];
+	if (frame == nullptr)
+	{
+		return nullptr;
+	}
+	SDL_Surface *argb = SDL_ConvertSurface(frame, SDL_PIXELFORMAT_ARGB8888);
+	if (argb == nullptr)
+	{
+		return nullptr;
+	}
+
+	TextureClass *texture = MSGNEW("TextureClass") TextureClass(argb->w, argb->h, WW3D_FORMAT_A8R8G8B8,
+		MIP_LEVELS_1, TextureClass::POOL_MANAGED, false, false);
+	SurfaceClass *surface = texture->Get_Surface_Level();
+	int pitch = 0;
+	Uint8 *bits = surface ? static_cast<Uint8 *>(surface->Lock(&pitch)) : nullptr;
+	if (bits == nullptr)
+	{
+		REF_PTR_RELEASE(surface);
+		REF_PTR_RELEASE(texture);
+		SDL_DestroySurface(argb);
+		return nullptr;
+	}
+	// SDL's ARGB8888 and Direct3D's A8R8G8B8 are the same bytes in memory.
+	for (int y = 0; y < argb->h; ++y)
+	{
+		memcpy(bits + y * pitch, static_cast<const Uint8 *>(argb->pixels) + y * argb->pitch, argb->w * 4);
+	}
+	surface->Unlock();
+	REF_PTR_RELEASE(surface);
+
+	Image *image = newInstance(Image);
+	Region2D uv;
+	uv.lo.x = 0.0f;
+	uv.lo.y = 0.0f;
+	uv.hi.x = 1.0f;
+	uv.hi.y = 1.0f;
+	ICoord2D size;
+	size.x = argb->w;
+	size.y = argb->h;
+	image->setStatus(IMAGE_STATUS_RAW_TEXTURE);
+	image->setRawTextureData(texture);
+	image->setUV(&uv);
+	image->setTextureWidth(size.x);
+	image->setTextureHeight(size.y);
+	image->setImageSize(&size);
+	SDL_DestroySurface(argb);
+
+	cursor->m_frameTextures[frameIndex] = texture;
+	cursor->m_frameImages[frameIndex] = image;
+	return image;
+}
+
+/**
+ * Draw the cursor on the PS5, where there is no OS cursor.
+ * GeneralsX @feature PS5 13/10/2026 The selected cursor's current .ani frame is drawn by the
+ * game, as a 2D image after the user interface (W3DDisplay calls draw() there), placed by its hot
+ * spot at the mouse position, in the same coordinates the game hit-tests clicks in. DXVK's D3D9
+ * cursor, the original W3DMouse's RM_DX8 path, exists only on Windows.
+ */
+void SDL3Mouse::drawConsoleCursor(void)
+{
+	AnimatedCursor *cursor = m_IsVisible ? m_consoleCursor : nullptr;
+	const Uint64 now = SDL_GetTicks();
+	if (now >= m_consoleTraceAt && now < 180000)
+	{
+		fprintf(stderr, "INFO: Mouse: %u events, at (%d, %d), cursor %s\n", m_consoleEvents,
+			m_currMouse.pos.x, m_currMouse.pos.y, cursor ? "drawn" : (m_IsVisible ? "missing" : "hidden"));
+		m_consoleTraceAt = now + 5000;
+	}
+	if (cursor == nullptr || cursor->m_frameCount <= 0 || TheDisplay == nullptr)
+	{
+		return;
+	}
+
+	// The .ani rate is the time a frame shows, in 1/60ths of a second.
+	const Uint64 jiffies = now * 60 / 1000;
+	const int rate = cursor->m_frameRate > 0 ? cursor->m_frameRate : 4;
+	int frameIndex = (int)((jiffies / (Uint64)rate) % (Uint64)cursor->m_frameCount);
+	if (cursor->m_frameSurfaces[frameIndex] == nullptr)
+	{
+		frameIndex = 0;
+	}
+	const Image *image = consoleCursorImage(cursor, frameIndex);
+	if (image == nullptr)
+	{
+		return;
+	}
+
+	// The size a PC player saw at the game's 1024x768 design resolution, so it reads on a TV.
+	const Real scale = MAX(1.0f, (Real)TheDisplay->getHeight() / (Real)DEFAULT_DISPLAY_HEIGHT);
+	const Int left = m_currMouse.pos.x - REAL_TO_INT(cursor->m_hotSpotX * scale);
+	const Int top = m_currMouse.pos.y - REAL_TO_INT(cursor->m_hotSpotY * scale);
+	TheDisplay->drawImage(image, left, top,
+		left + REAL_TO_INT(image->getImageWidth() * scale), top + REAL_TO_INT(image->getImageHeight() * scale));
+}
