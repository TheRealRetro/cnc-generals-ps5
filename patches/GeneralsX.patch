+
 //-----------------------------------------------------------------------------
 /**
  * The LookAt Translator is responsible for camera movements. It is directly responsible for
@@ -442,6 +450,19 @@ GameMessageDisposition LookAtTranslator::translateGameMessage(const GameMessage
 		{
 			Coord2D offset = {0, 0};
 
+			// GeneralsX @feature PS5 13/10/2026 A deflected gamepad stick scrolls like a held key, unless
+			// another scroll is under way.
+			const Bool stickDeflected = m_stickScroll.x != 0.0f || m_stickScroll.y != 0.0f;
+			if (stickDeflected && !m_isScrolling && !TheInGameUI->isSelecting() &&
+				!(TheShell && TheShell->isShellActive()))
+			{
+				setScrolling(SCROLL_STICK);
+			}
+			else if (!stickDeflected && m_isScrolling && m_scrollType == SCROLL_STICK)
+			{
+				stopScrolling();
+			}
+
 			if (m_isScrolling && !TheInGameUI->isScrolling())
 			{
 				// If we've been forced to stop scrolling (script action?)
@@ -528,6 +549,12 @@ GameMessageDisposition LookAtTranslator::translateGameMessage(const GameMessage
 						}
 					}
 					break;
+				case SCROLL_STICK:
+					{
+						offset.x = TheGlobalData->m_horizontalScrollSpeedFactor * fpsRatio * SCROLL_AMT * TheGlobalData->m_keyboardScrollFactor * m_stickScroll.x;
+						offset.y = TheGlobalData->m_verticalScrollSpeedFactor * fpsRatio * SCROLL_AMT * TheGlobalData->m_keyboardScrollFactor * m_stickScroll.y;
+					}
+					break;
 				}
 
 				TheInGameUI->setScrollAmount(offset);
