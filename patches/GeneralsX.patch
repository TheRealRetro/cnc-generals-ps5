+/**
+ * SetupPS5Title
+ *
+ * GeneralsX @build PS5 13/10/2026 The console title's environment, before anything else runs:
+ * standard error to the kernel log, the game data in the title folder (/app0, which the
+ * virtual current directory also starts in: ps5/runtime/ps5_vcwd.c), and HOME pointing at
+ * writable storage for Options.ini, saves and replays: the title's download data when the
+ * console gives it one, else a folder beside the game. A title has no environment of its own.
+ */
+static void SetupPS5Title()
+{
+	ps5_title_init("C&C Generals");
+
+	// A log to fetch over FTP: ShadowMountPlus gives the title the console's /data.
+	if (mkdir("/data/generals", 0777) == 0 || errno == EEXIST) {
+		if (ps5_title_log_file("/data/generals/generals.log") == 0) {
+			ps5_say("log file /data/generals/generals.log");
+		}
+	}
+
+	// SDL's controller, mouse and keyboard drivers say what they found (SDL logs to stderr).
+	SDL_SetLogPriority(SDL_LOG_CATEGORY_INPUT, SDL_LOG_PRIORITY_INFO);
+	// SDL drops controller input while no window has keyboard focus. The title is the console's
+	// only app on screen, and the shell takes the pad itself when it is in front.
+	SDL_SetHint(SDL_HINT_JOYSTICK_ALLOW_BACKGROUND_EVENTS, "1");
+
+	struct stat st;
+	const char *home = (stat("/download0", &st) == 0 && S_ISDIR(st.st_mode)) ? "/download0" : "/app0/userdata";
+	if (strcmp(home, "/app0/userdata") == 0 && mkdir(home, 0777) == 0) {
+		chmod(home, 0777);
+	}
+	setenv("HOME", home, 1);
+	setenv("CNC_GENERALS_PATH", "/app0/", 1);
+	setenv("DXVK_WSI_DRIVER", "SDL3", 1);
+	// The Vulkan driver's compiled-shader cache: it otherwise tries the read-only title folder and
+	// gives up, compiling every shader again on each run.
+	char shaderCache[64];
+	snprintf(shaderCache, sizeof(shaderCache), "%s/radv-shader-cache", home);
+	setenv("MESA_SHADER_CACHE_DIR", shaderCache, 0);
+	ps5_say("game data /app0, user data %s", home);
+}
+#endif
