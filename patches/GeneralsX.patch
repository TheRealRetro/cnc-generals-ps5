+	trace(window);
+	moveCursor(window, dt);
+	scroll();
+
+	// Clicks happen where the cursor is now.
+	const struct { SDL_GamepadButton button; Uint8 mouse; } clicks[] = {
+		{ SDL_GAMEPAD_BUTTON_SOUTH, SDL_BUTTON_LEFT },
+		{ SDL_GAMEPAD_BUTTON_EAST, SDL_BUTTON_RIGHT },
+	};
+	for (const auto &click : clicks)
+	{
+		const bool down = SDL_GetGamepadButton(m_pad, click.button);
