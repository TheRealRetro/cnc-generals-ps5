diff --git a/Core/GameEngine/Source/Common/System/UnicodeString.cpp b/Core/GameEngine/Source/Common/System/UnicodeString.cpp
index d3012cffa..84ee3c3cb 100644
--- a/Core/GameEngine/Source/Common/System/UnicodeString.cpp
+++ b/Core/GameEngine/Source/Common/System/UnicodeString.cpp
@@ -575,12 +575,13 @@ void UnicodeString::format_va(const WideChar* format, va_list args)
 	// GeneralsX @bugfix fbraz 03/06/2026 vswprintf rejects non-ASCII wide chars in the C locale
 	// (returns -1 for any format string containing e.g. Cyrillic). Use a UTF-8 locale for
 	// the duration of the call so Cyrillic format strings pass through correctly.
-#ifndef _WIN32
+	// GeneralsX @build PS5 13/10/2026 The PS5 exports no uselocale(); its vswprintf stays in the C locale.
+#if !defined(_WIN32) && !defined(__PROSPERO__)
 	static locale_t s_utf8_locale = newlocale(LC_CTYPE_MASK, "UTF-8", (locale_t)0);
 	locale_t old_locale = uselocale(s_utf8_locale);
 #endif
 	const int result = vswprintf(buf, sizeof(buf)/sizeof(WideChar), effectiveFormat, args);
-#ifndef _WIN32
+#if !defined(_WIN32) && !defined(__PROSPERO__)
 	uselocale(old_locale);
 #endif
 	if (result >= 0)
