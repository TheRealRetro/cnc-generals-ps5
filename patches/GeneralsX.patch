diff --git a/cmake/patches/gamemath-ps5.cmake b/cmake/patches/gamemath-ps5.cmake
new file mode 100644
index 000000000..e9255dfd3
--- /dev/null
+++ b/cmake/patches/gamemath-ps5.cmake
@@ -0,0 +1,27 @@
+# GeneralsX @build PS5 13/10/2026 Run as GameMath's FetchContent patch step (cmake/gamemath.cmake),
+# in its source directory. gmath.h is FreeBSD's math.h, and the PS5 is FreeBSD:
+#  - its C99 section is off on Linux and macOS, whose headers leave __ISO_C_VISIBLE undefined, but
+#    comes on for the PS5 and collides with the system's declarations and GameMath's own;
+#  - the PS5's <math.h> declares signgam outside its extern "C" block, so gmath.h's own declaration
+#    (inside one) conflicts in C++; the system's serves.
+# An edit already made is not made again.
+function(patch_for_ps5 path from to)
+    file(READ "${path}" content)
+    string(FIND "${content}" "${to}" already)
+    if(NOT already EQUAL -1)
+        return()
+    endif()
+    string(FIND "${content}" "${from}" found)
+    if(found EQUAL -1)
+        message(FATAL_ERROR "gamemath-ps5.cmake: '${from}' not found in ${path}")
+    endif()
+    string(REPLACE "${from}" "${to}" content "${content}")
+    file(WRITE "${path}" "${content}")
+endfunction()
+
+patch_for_ps5(include/gmath.h
+    "#if __ISO_C_VISIBLE >= 1999\n"
+    "#if __ISO_C_VISIBLE >= 1999 && !defined(__PROSPERO__)\n")
+patch_for_ps5(include/gmath.h
+    "extern int signgam;\n"
+    "#if !defined(__PROSPERO__) /* the PS5's <math.h> declares it */\nextern int signgam;\n#endif\n")
diff --git a/cmake/patches/gamespy-ps5.cmake b/cmake/patches/gamespy-ps5.cmake
new file mode 100644
index 000000000..7afc6b9e7
--- /dev/null
+++ b/cmake/patches/gamespy-ps5.cmake
@@ -0,0 +1,27 @@
+# GeneralsX @build PS5 13/10/2026 Run as the GameSpy SDK's FetchContent patch step (cmake/gamespy.cmake),
+# in its source directory. The SDK picks its Unix code (BSD sockets, pthreads: its linux/ sources) by
+# __linux__; the PS5 (FreeBSD to the compiler, __PROSPERO__) has the same interfaces, so it takes that
+# path too. A file already patched is left alone.
+function(patch_for_ps5 path from to)
+    file(READ "${path}" content)
+    string(FIND "${content}" "__PROSPERO__" already)
+    if(NOT already EQUAL -1)
+        return()
+    endif()
+    string(FIND "${content}" "${from}" found)
+    if(found EQUAL -1)
+        message(FATAL_ERROR "gamespy-ps5.cmake: '${from}' not found in ${path}")
+    endif()
+    string(REPLACE "${from}" "${to}" content "${content}")
+    file(WRITE "${path}" "${content}")
+endfunction()
+
+patch_for_ps5(include/gamespy/gscommon.h
+    "#if !defined(_LINUX) && (defined(__linux__) ||"
+    "#if !defined(_LINUX) && (defined(__linux__) || defined(__PROSPERO__) ||")
+patch_for_ps5(include/gamespy/gsplatform.h
+    "#if defined(__linux__) || (defined(__APPLE__)"
+    "#if defined(__linux__) || defined(__PROSPERO__) || (defined(__APPLE__)")
+foreach(path src/common/gsplatformutil.c src/common/gsplatformsocket.c src/common/gsplatformthread.c)
+    patch_for_ps5(${path} "#elif defined(__linux__)" "#elif defined(__linux__) || defined(__PROSPERO__)")
+endforeach()
diff --git a/cmake/ps5.cmake b/cmake/ps5.cmake
new file mode 100644
index 000000000..b7d73199c
--- /dev/null
+++ b/cmake/ps5.cmake
@@ -0,0 +1,34 @@
+# GeneralsX @build PS5 13/10/2026 PlayStation 5 homebrew title.
+# The payload SDK's toolchain file sets PS5. The port's own folder (SAGE_PS5_DIR) holds the
+# title runtime and the link script: a PS5 title is linked with the RADV Vulkan driver and
+# signed by that script, not by the SDK's compiler driver, so CMake hands it the objects and
+# static libraries it computed, in link order.
+if(PS5)
+    foreach(var SAGE_PS5_DIR SAGE_PS5_DXVK_DIR SAGE_PS5_DXVK_LIB SAGE_PS5_SCE_SYS SAGE_PS5_DIST)
+        if(NOT ${var})
+            message(FATAL_ERROR "The PS5 build needs -D${var}=... (see the port's scripts/build-generals.sh)")
+        endif()
+    endforeach()
+
+    set(CMAKE_CXX_LINK_EXECUTABLE
+        "bash ${SAGE_PS5_DIR}/tools/cmake-link.sh ${SAGE_PS5_SCE_SYS} ${SAGE_PS5_DIST} <TARGET> <OBJECTS> <LINK_LIBRARIES>")
+    message(STATUS "PS5 title: linked by ${SAGE_PS5_DIR}/tools/cmake-link.sh into ${SAGE_PS5_DIST}")
+
+    # FFmpeg for the Bink videos: the static libraries the port's scripts/build-ffmpeg.sh installs
+    # into the prefix (CMAKE_FIND_ROOT_PATH). The SDK's pkg-config searches only its own sysroot, so
+    # the target the GameEngineDevice libraries otherwise get from pkg_check_modules is made here.
+    if(RTS_BUILD_OPTION_FFMPEG AND NOT TARGET PkgConfig::FFMPEG)
+        find_path(FFMPEG_INCLUDE_DIRS libavcodec/avcodec.h REQUIRED)
+        set(FFMPEG_LIBRARIES)
+        foreach(lib avformat avcodec swscale avutil)
+            find_library(FFMPEG_${lib}_LIBRARY NAMES lib${lib}.a REQUIRED)
+            list(APPEND FFMPEG_LIBRARIES ${FFMPEG_${lib}_LIBRARY})
+        endforeach()
+        add_library(PkgConfig::FFMPEG INTERFACE IMPORTED GLOBAL)
+        set_target_properties(PkgConfig::FFMPEG PROPERTIES
+            INTERFACE_INCLUDE_DIRECTORIES "${FFMPEG_INCLUDE_DIRS}"
+            INTERFACE_LINK_LIBRARIES "${FFMPEG_LIBRARIES}")
+        set(FFMPEG_FOUND TRUE)
+        message(STATUS "PS5 title: FFmpeg from ${FFMPEG_INCLUDE_DIRS}")
+    endif()
+endif()
