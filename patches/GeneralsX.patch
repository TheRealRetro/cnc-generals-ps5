+**	along with this program.  If not, see <http://www.gnu.org/licenses/>.
+*/
+
+// MiniAudioPS5Backend.h - MiniAudio playback on the PlayStation 5's AudioOut.
+//
+// GeneralsX @feature PS5 13/10/2026 None of MiniAudio's backends exists on the console. This is a
+// custom backend in MiniAudio's blocking-write form: MiniAudio's own audio thread calls
+// onDeviceWrite, which hands the console 256-frame grains of 48 kHz interleaved stereo 16-bit
+// samples; sceAudioOutOutput blocks until the console takes one, which paces the thread.
+// The calls and the port setup are the ones PS5_VulkanTemplate and PS5_vkQuake run on hardware.
+//
+// Include once, after the MiniAudio implementation, in MiniAudioManager.cpp.
+
+#pragma once
+
+#if defined(SAGE_PLATFORM_PS5)
+
+#include <cstdint>
+#include <cstring>
+
+extern "C" {
+int sceAudioOutInit(void);
+int sceAudioOutOpen(int32_t user, int32_t type, int32_t index, uint32_t grain, uint32_t rate, uint32_t format);
+int sceAudioOutOutput(int32_t port, const void *samples);
+int sceAudioOutClose(int32_t port);
+}
+
+namespace MiniAudioPS5 {
+
+static const ma_uint32 kGrainFrames = 256;
+static const ma_uint32 kSampleRate = 48000;
+static const ma_uint32 kChannels = 2;
+static const int32_t kSystemUser = 0xff;
+static const int32_t kPortMain = 0;
+static const uint32_t kFormatS16Stereo = 1;
+static const int kAlreadyInitialized = (int)0x8026000e;
+
+// The game opens one playback device.
+static int32_t s_port = -1;
+static int16_t s_grain[kGrainFrames * kChannels] __attribute__((aligned(64)));
+static ma_uint32 s_grainFill = 0;
+
+static void fillDeviceInfo(ma_device_info *info)
+{
+	memset(info, 0, sizeof(*info));
+	ma_strncpy_s(info->name, sizeof(info->name), "PS5 AudioOut", (size_t)-1);
+	info->isDefault = MA_TRUE;
+	info->nativeDataFormatCount = 1;
+	info->nativeDataFormats[0].format = ma_format_s16;
+	info->nativeDataFormats[0].channels = kChannels;
+	info->nativeDataFormats[0].sampleRate = kSampleRate;
+	info->nativeDataFormats[0].flags = 0;
+}
+
+static ma_result onContextEnumerateDevices(ma_context *context, ma_enum_devices_callback_proc callback, void *userData)
+{
+	ma_device_info info;
+	fillDeviceInfo(&info);
+	callback(context, ma_device_type_playback, &info, userData);
+	return MA_SUCCESS;
+}
+
+static ma_result onContextGetDeviceInfo(ma_context *context, ma_device_type type, const ma_device_id *id, ma_device_info *info)
+{
+	(void)context;
+	(void)id;
+	if (type != ma_device_type_playback) {
+		return MA_NO_DEVICE;
+	}
+	fillDeviceInfo(info);
+	return MA_SUCCESS;
+}
+
+static ma_result onDeviceInit(ma_device *device, const ma_device_config *config, ma_device_descriptor *playback, ma_device_descriptor *capture)
+{
+	(void)device;
+	(void)capture;
+	if (config->deviceType != ma_device_type_playback) {
+		return MA_DEVICE_TYPE_NOT_SUPPORTED;
+	}
+	if (s_port >= 0) {
+		return MA_DEVICE_ALREADY_INITIALIZED;
+	}
+
+	playback->format = ma_format_s16;
+	playback->channels = kChannels;
+	playback->sampleRate = kSampleRate;
+	ma_channel_map_init_standard(ma_standard_channel_map_default, playback->channelMap, MA_MAX_CHANNELS, kChannels);
+	playback->periodSizeInFrames = kGrainFrames;
+	playback->periodCount = 2;
+
+	s_port = sceAudioOutOpen(kSystemUser, kPortMain, 0, kGrainFrames, kSampleRate, kFormatS16Stereo);
+	if (s_port < 0) {
+		fprintf(stderr, "AUDIO: sceAudioOutOpen failed: 0x%08x\n", (unsigned)s_port);
+		s_port = -1;
+		return MA_FAILED_TO_OPEN_BACKEND_DEVICE;
+	}
+	s_grainFill = 0;
+	fprintf(stderr, "AUDIO: PS5 AudioOut port %d, 48 kHz stereo, %u-frame grains\n", (int)s_port, (unsigned)kGrainFrames);
+	return MA_SUCCESS;
+}
+
+static ma_result onDeviceUninit(ma_device *device)
+{
+	(void)device;
+	if (s_port >= 0) {
+		sceAudioOutOutput(s_port, nullptr); // drain the grain still queued
+		sceAudioOutClose(s_port);
+		s_port = -1;
+	}
+	return MA_SUCCESS;
+}
+
+static ma_result onDeviceStart(ma_device *device)
+{
+	(void)device;
+	return MA_SUCCESS;
+}
+
+static ma_result onDeviceStop(ma_device *device)
+{
+	(void)device;
+	return MA_SUCCESS;
+}
+
+static ma_result onDeviceWrite(ma_device *device, const void *frames, ma_uint32 frameCount, ma_uint32 *framesWritten)
+{
+	(void)device;
+	const int16_t *in = static_cast<const int16_t *>(frames);
+	ma_uint32 remaining = frameCount;
+	while (remaining > 0) {
+		const ma_uint32 take = (kGrainFrames - s_grainFill) < remaining ? (kGrainFrames - s_grainFill) : remaining;
+		memcpy(&s_grain[s_grainFill * kChannels], in, take * kChannels * sizeof(int16_t));
+		s_grainFill += take;
+		in += take * kChannels;
+		remaining -= take;
+		if (s_grainFill == kGrainFrames) {
+			if (sceAudioOutOutput(s_port, s_grain) < 0) {
+				return MA_IO_ERROR;
+			}
+			s_grainFill = 0;
+		}
+	}
+	if (framesWritten != nullptr) {
+		*framesWritten = frameCount;
+	}
+	return MA_SUCCESS;
+}
+
+static ma_result onContextUninit(ma_context *context)
+{
+	(void)context;
+	return MA_SUCCESS;
+}
+
+static ma_result onContextInit(ma_context *context, const ma_context_config *config, ma_backend_callbacks *callbacks)
+{
+	(void)context;
+	(void)config;
+	const int init = sceAudioOutInit();
+	if (init < 0 && init != kAlreadyInitialized) {
+		fprintf(stderr, "AUDIO: sceAudioOutInit failed: 0x%08x\n", (unsigned)init);
+		return MA_NO_BACKEND;
+	}
+	callbacks->onContextInit = onContextInit;
+	callbacks->onContextUninit = onContextUninit;
+	callbacks->onContextEnumerateDevices = onContextEnumerateDevices;
+	callbacks->onContextGetDeviceInfo = onContextGetDeviceInfo;
+	callbacks->onDeviceInit = onDeviceInit;
+	callbacks->onDeviceUninit = onDeviceUninit;
+	callbacks->onDeviceStart = onDeviceStart;
+	callbacks->onDeviceStop = onDeviceStop;
+	callbacks->onDeviceRead = nullptr;
+	callbacks->onDeviceWrite = onDeviceWrite;
+	callbacks->onDeviceDataLoop = nullptr; // MiniAudio's own thread drives onDeviceWrite
+	callbacks->onDeviceDataLoopWakeup = nullptr;
+	return MA_SUCCESS;
+}
+
+// Point a context config at this backend; init the context with the backend list it returns.
+static const ma_backend *configureContext(ma_context_config *config, ma_uint32 *backendCount)
+{
+	static const ma_backend backends[] = { ma_backend_custom };
+	config->custom.onContextInit = onContextInit;
+	*backendCount = 1;
+	return backends;
+}
+
+} // namespace MiniAudioPS5
