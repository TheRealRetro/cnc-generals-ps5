+	setKey(window, SDL_SCANCODE_KP_2, axis(m_pad, SDL_GAMEPAD_AXIS_LEFT_TRIGGER) > kTriggerThreshold);
+	setKey(window, SDL_SCANCODE_KP_8, axis(m_pad, SDL_GAMEPAD_AXIS_RIGHT_TRIGGER) > kTriggerThreshold);
+}
