index 000000000..cf5e78322
--- /dev/null
+++ b/src/video/ps5/SDL_ps5video.c
@@ -0,0 +1,235 @@
+/*
+  Simple DirectMedia Layer
+  Copyright (C) 1997-2026 Sam Lantinga <slouken@libsdl.org>
+
+  This software is provided 'as-is', without any express or implied
+  warranty.  In no event will the authors be held liable for any damages
+  arising from the use of this software.
+
+  Permission is granted to anyone to use this software for any purpose,
+  including commercial applications, and to alter it and redistribute it
+  freely, subject to the following restrictions:
+
+  1. The origin of this software must not be misrepresented; you must not
+     claim that you wrote the original software. If you use this software
+     in a product, an acknowledgment in the product documentation would be
+     appreciated but is not required.
+  2. Altered source versions must be plainly marked as such, and must not be
+     misrepresented as being the original software.
+  3. This notice may not be removed or altered from any source distribution.
+*/
+#include "SDL_internal.h"
+
+#ifdef SDL_VIDEO_DRIVER_PS5
+
+/* PlayStation 5 homebrew video driver.
+ *
+ * The console has no window system and no Vulkan loader: the title links a
+ * Vulkan driver (RADV built for the console by PS5_Vulkan) whose ICD entry
+ * point is vk_icdGetInstanceProcAddr, and presents through VK_KHR_display on
+ * the console's VideoOut. There is one display and one window; whatever size
+ * the window is given, the presenter scales it onto the display plane. */
+
+#include "SDL_ps5video.h"
+#include "../SDL_vulkan_internal.h"
+#include "../../events/SDL_keyboard_c.h"
+#include "../../events/SDL_mouse_c.h"
+#include "../../events/SDL_windowevents_c.h"
+#include "../../core/ps5/SDL_ps5.h"
+
+#define PS5VID_DRIVER_NAME "ps5"
+
+/* The display's native mode as RADV's VK_KHR_display reports it on the console. */
+#define PS5_NATIVE_WIDTH  3840
+#define PS5_NATIVE_HEIGHT 2160
+
+/* Provided by the RADV archive the title links; weak so that a title without
+ * Vulkan still links (SDL_Vulkan_LoadLibrary then fails cleanly). */
+extern PFN_vkVoidFunction vk_icdGetInstanceProcAddr(VkInstance instance, const char *name) __attribute__((weak));
+
+/* A stand-in loader handle: the driver is linked, not loaded. */
+static char ps5_vulkan_linked;
+
+static bool PS5_VideoInit(SDL_VideoDevice *_this)
+{
+    SDL_DisplayMode mode;
+
+    SDL_zero(mode);
+    mode.format = SDL_PIXELFORMAT_XRGB8888;
+    mode.w = PS5_NATIVE_WIDTH;
+    mode.h = PS5_NATIVE_HEIGHT;
+    mode.refresh_rate_numerator = 60000;
+    mode.refresh_rate_denominator = 1001;
+    if (SDL_AddBasicVideoDisplay(&mode) == 0) {
+        return false;
+    }
+
+    // The shell's splash covers every frame until the title dismisses it.
+    (void)sceSystemServiceHideSplashScreen();
+
+    PS5_InitKeyboardMouse();
+    return true;
+}
+
+static void PS5_VideoQuit(SDL_VideoDevice *_this)
+{
+    PS5_QuitKeyboardMouse();
+}
+
+/* Every common 16:9 size: the display plane scales any of them to the TV, so
+ * a "mode change" only changes the size the application renders at. */
+static bool PS5_GetDisplayModes(SDL_VideoDevice *_this, SDL_VideoDisplay *display)
+{
+    static const int sizes[][2] = {
+        { 3840, 2160 }, { 2560, 1440 }, { 1920, 1080 }, { 1600, 900 }, { 1366, 768 }, { 1280, 720 }
+    };
+    for (int i = 0; i < (int)SDL_arraysize(sizes); i++) {
+        SDL_DisplayMode mode;
+        SDL_zero(mode);
+        mode.format = SDL_PIXELFORMAT_XRGB8888;
+        mode.w = sizes[i][0];
+        mode.h = sizes[i][1];
+        mode.refresh_rate_numerator = 60000;
+        mode.refresh_rate_denominator = 1001;
+        SDL_AddFullscreenDisplayMode(display, &mode);
+    }
+    return true;
+}
+
+static bool PS5_SetDisplayMode(SDL_VideoDevice *_this, SDL_VideoDisplay *display, SDL_DisplayMode *mode)
+{
+    return true;
+}
+
+static bool PS5_CreateWindow(SDL_VideoDevice *_this, SDL_Window *window, SDL_PropertiesID create_props)
+{
+    SDL_WindowData *data = (SDL_WindowData *)SDL_calloc(1, sizeof(SDL_WindowData));
+    if (!data) {
+        return false;
+    }
+    data->sdl_window = window;
+    window->internal = data;
+    window->x = 0;
+    window->y = 0;
+
+    // The only window always has the input.
+    SDL_SetMouseFocus(window);
+    SDL_SetKeyboardFocus(window);
+    return true;
+}
+
+static void PS5_DestroyWindow(SDL_VideoDevice *_this, SDL_Window *window)
+{
+    SDL_free(window->internal);
+    window->internal = NULL;
+}
+
+static void PS5_SetWindowSize(SDL_VideoDevice *_this, SDL_Window *window)
+{
+    SDL_SendWindowEvent(window, SDL_EVENT_WINDOW_RESIZED, window->pending.w, window->pending.h);
+}
+
+static SDL_FullscreenResult PS5_SetWindowFullscreen(SDL_VideoDevice *_this, SDL_Window *window, SDL_VideoDisplay *display, SDL_FullscreenOp fullscreen)
+{
+    return SDL_FULLSCREEN_SUCCEEDED;
+}
+
+static void PS5_PumpEvents(SDL_VideoDevice *_this)
+{
+    PS5_PumpKeyboardMouse(_this);
+}
+
+static bool PS5_Vulkan_LoadLibrary(SDL_VideoDevice *_this, const char *path)
+{
+    if (_this->vulkan_config.loader_handle) {
+        return SDL_SetError("Vulkan already loaded");
+    }
+    if (!vk_icdGetInstanceProcAddr) {
+        return SDL_SetError("No Vulkan driver is linked into this title");
+    }
+
+    _this->vulkan_config.vkGetInstanceProcAddr = (SDL_FunctionPointer)vk_icdGetInstanceProcAddr;
+    _this->vulkan_config.vkEnumerateInstanceExtensionProperties =
+        (SDL_FunctionPointer)vk_icdGetInstanceProcAddr(VK_NULL_HANDLE, "vkEnumerateInstanceExtensionProperties");
+    if (!_this->vulkan_config.vkEnumerateInstanceExtensionProperties) {
+        return SDL_SetError("The linked Vulkan driver has no vkEnumerateInstanceExtensionProperties");
+    }
+    _this->vulkan_config.loader_handle = &ps5_vulkan_linked;
+    SDL_strlcpy(_this->vulkan_config.loader_path, "(linked)", SDL_arraysize(_this->vulkan_config.loader_path));
+    return true;
+}
+
+static void PS5_Vulkan_UnloadLibrary(SDL_VideoDevice *_this)
+{
+    _this->vulkan_config.loader_handle = NULL;
+}
+
+static char const *const *PS5_Vulkan_GetInstanceExtensions(SDL_VideoDevice *_this, Uint32 *count)
+{
+    static const char *const extensions[] = { VK_KHR_SURFACE_EXTENSION_NAME, VK_KHR_DISPLAY_EXTENSION_NAME };
+    if (count) {
+        *count = SDL_arraysize(extensions);
+    }
+    return extensions;
+}
+
+static bool PS5_Vulkan_CreateSurface(SDL_VideoDevice *_this, SDL_Window *window, VkInstance instance,
+                                     const struct VkAllocationCallbacks *allocator, VkSurfaceKHR *surface)
+{
+    if (!_this->vulkan_config.loader_handle) {
+        return SDL_SetError("Vulkan is not loaded");
+    }
+    return SDL_Vulkan_Display_CreateSurface(_this->vulkan_config.vkGetInstanceProcAddr, instance, allocator, surface);
+}
+
+static void PS5_Vulkan_DestroySurface(SDL_VideoDevice *_this, VkInstance instance, VkSurfaceKHR surface,
+                                      const struct VkAllocationCallbacks *allocator)
+{
+    if (_this->vulkan_config.loader_handle) {
+        SDL_Vulkan_DestroySurface_Internal(_this->vulkan_config.vkGetInstanceProcAddr, instance, surface, allocator);
+    }
+}
+
+static void PS5_DeleteDevice(SDL_VideoDevice *device)
+{
+    SDL_free(device);
+}
+
+static SDL_VideoDevice *PS5_CreateDevice(void)
+{
+    SDL_VideoDevice *device = (SDL_VideoDevice *)SDL_calloc(1, sizeof(SDL_VideoDevice));
+    if (!device) {
+        return NULL;
+    }
+
+    device->VideoInit = PS5_VideoInit;
+    device->VideoQuit = PS5_VideoQuit;
+    device->GetDisplayModes = PS5_GetDisplayModes;
+    device->SetDisplayMode = PS5_SetDisplayMode;
+    device->PumpEvents = PS5_PumpEvents;
+
+    device->CreateSDLWindow = PS5_CreateWindow;
+    device->DestroyWindow = PS5_DestroyWindow;
+    device->SetWindowSize = PS5_SetWindowSize;
+    device->SetWindowFullscreen = PS5_SetWindowFullscreen;
+
+    device->Vulkan_LoadLibrary = PS5_Vulkan_LoadLibrary;
+    device->Vulkan_UnloadLibrary = PS5_Vulkan_UnloadLibrary;
+    device->Vulkan_GetInstanceExtensions = PS5_Vulkan_GetInstanceExtensions;
+    device->Vulkan_CreateSurface = PS5_Vulkan_CreateSurface;
+    device->Vulkan_DestroySurface = PS5_Vulkan_DestroySurface;
+
+    // A "mode" only sets the size the window renders at; the display plane scales it.
+    device->device_caps = VIDEO_DEVICE_CAPS_MODE_SWITCHING_EMULATED;
+    device->free = PS5_DeleteDevice;
+    return device;
+}
+
+VideoBootStrap PS5_bootstrap = {
+    PS5VID_DRIVER_NAME, "PlayStation 5 video driver (VK_KHR_display)",
+    PS5_CreateDevice,
+    NULL, // no ShowMessageBox implementation
+    false
+};
+
+#endif // SDL_VIDEO_DRIVER_PS5
