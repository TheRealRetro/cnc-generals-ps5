+#ifndef SDL_ps5_h_
+#define SDL_ps5_h_
+
+/* PlayStation 5 homebrew (public payload SDK, no Sony SDK): the console
+ * services the PS5 drivers share. No SDK header declares these exports; the
+ * signatures are the ones PS5_vkQuake, PS5_RetroArch and PS5_VulkanTemplate
+ * call on hardware. */
+
+/* The signed-in users, at most four; unused entries are -1. */
+typedef struct PS5_UserList
+{
+    Sint32 user_id[4];
+} PS5_UserList;
+
+extern int sceUserServiceInitialize(const void *params);
+extern int sceUserServiceGetInitialUser(Sint32 *user_id);
+extern int sceUserServiceGetLoginUserIdList(PS5_UserList *list);
+extern int sceSystemServiceHideSplashScreen(void);
+extern int sceKernelUsleep(Uint32 microseconds);
+
+/* Initialize the user service once; safe to call from every driver. */
+extern bool PS5_InitUserService(void);
+
+/* The user who started the title, or -1. */
+extern Sint32 PS5_GetInitialUser(void);
+
+#endif /* SDL_ps5_h_ */
