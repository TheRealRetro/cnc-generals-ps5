+    if(SDL_JOYSTICK)
+      set(SDL_JOYSTICK_PS5 1)
+      sdl_glob_sources("${SDL3_SOURCE_DIR}/src/joystick/ps5/*.c")
+      set(HAVE_SDL_JOYSTICK TRUE)
+    endif()
+    if(SDL_AUDIO)
+      set(SDL_AUDIO_DRIVER_PS5 1)
+      sdl_glob_sources("${SDL3_SOURCE_DIR}/src/audio/ps5/*.c")
+      set(HAVE_SDL_AUDIO TRUE)
+    endif()
+  endif()
+
   if(SDL_TRAY)
     sdl_glob_sources(
       "${SDL3_SOURCE_DIR}/src/tray/unix/*.c"
@@ -3486,7 +3514,9 @@ int main(void)
   if(NOT APPLE)
     check_symbol_exists(vfork "unistd.h" LIBC_HAS_VFORK)
   endif()
-  if(HAVE_POSIX_SPAWN AND (APPLE OR LIBC_HAS_VFORK))
