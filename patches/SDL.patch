@@ -71,6 +71,46 @@ static char *readSymLink(const char *path)
     return NULL;
 }
 
+#ifdef SDL_PLATFORM_PS5
+/* A title's own folder is /app0/. Writable state goes to /download0/ (the
+ * title's download data, kept while it is installed) when the console gives
+ * the title one, else into its own folder, as the PS5 Vulkan titles write
+ * theirs. Folders are made 0777 so the console's FTP server can reach them. */
+static const char *PS5_WritableRoot(void)
+{
+    struct stat st;
+    if (stat("/download0", &st) == 0 && S_ISDIR(st.st_mode)) {
+        return "/download0/";
+    }
+    return "/app0/";
+}
+
+static char *PS5_MakeWritableFolder(const char *first, const char *second)
+{
+    const char *root = PS5_WritableRoot();
+    const size_t len = SDL_strlen(root) + SDL_strlen(first) + SDL_strlen(second) + 3;
+    char *result = (char *)SDL_malloc(len);
+    if (!result) {
+        return NULL;
+    }
+    if (*first) {
+        SDL_snprintf(result, len, "%s%s/%s/", root, first, second);
+    } else {
+        SDL_snprintf(result, len, "%s%s/", root, second);
+    }
+    for (char *p = result + SDL_strlen(root); *p; p++) {
+        if (*p == '/') {
+            *p = '\0';
+            if (mkdir(result, 0777) == 0) {
+                (void)chmod(result, 0777);
+            }
+            *p = '/';
+        }
+    }
+    return result;
+}
+#endif
+
