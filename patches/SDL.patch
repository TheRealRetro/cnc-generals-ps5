+#include "SDL_internal.h"
+
+#ifdef SDL_VIDEO_DRIVER_PS5
+
+/* USB and Bluetooth keyboards and mice on the PS5 (libSceKeyboard, libSceMouse).
+ *
+ * The module ids, open sequence and record layouts below are the ones
+ * BlackBearReloaded's device-tested ps5-native-gamepad-input-research
+ * documents (KEYBOARD-MOUSE.md). Keyboard records carry HID usage ids, which
+ * are SDL scancodes as they are; mouse records carry relative motion. */
+
+#include "SDL_ps5video.h"
+#include "../../events/SDL_keyboard_c.h"
+#include "../../events/SDL_mouse_c.h"
+#include "../../core/ps5/SDL_ps5.h"
+
+extern int sceSysmoduleLoadModule(Uint16 id);
+extern int sceUserServiceGetForegroundUser(Sint32 *user_id);
+extern int sceKeyboardInit(void);
+extern int sceKeyboardOpen(Sint32 user, int type, int index, const void *param);
+extern int sceKeyboardRead(int handle, void *records, int count);
+extern int sceMouseInit(void);
+extern int sceMouseOpen(Sint32 user, int type, int index, const void *param);
+extern int sceMouseRead(int handle, void *records, int count);
+
+#define PS5_SYSMODULE_KEYBOARD 0x0106
+#define PS5_SYSMODULE_MOUSE    0x00a9
+
+typedef struct PS5_KeyboardRecord
+{
+    Uint64 timestamp;
+    Uint8 intercepted;
+    Uint8 reserved0[7];
+    Uint8 connected;
+    Uint8 reserved1[3];
+    Uint32 length;
+    Uint32 leds;
+    Uint32 modifiers; // bit n is HID usage 0xE0 + n
+    Uint16 keycodes[16];
+    Uint8 reserved2[32];
+} PS5_KeyboardRecord;
+
+typedef struct PS5_MouseRecord
+{
+    Uint64 timestamp;
+    Uint8 connected;
+    Uint8 reserved0[3];
+    Uint32 buttons; // bit 31: the shell has the mouse
+    Sint32 x, y, wheel, tilt;
+    Uint8 reserved1[8];
+} PS5_MouseRecord;
+
+SDL_COMPILE_TIME_ASSERT(ps5_keyboard_record, sizeof(PS5_KeyboardRecord) == 96);
+SDL_COMPILE_TIME_ASSERT(ps5_mouse_record, sizeof(PS5_MouseRecord) == 40);
+
+#define PS5_INPUT_INDEXES 2
+#define PS5_MOUSE_INTERCEPTED 0x80000000u
+#define PS5_MODIFIER_CTRL 0x11
+#define PS5_MODIFIER_SHIFT 0x22
+#define PS5_MODIFIER_ALT 0x44
+#define PS5_MODIFIER_GUI 0x88
+
+static bool kbm_opened;
+static int keyboard_handles[PS5_INPUT_INDEXES] = { -1, -1 };
+static int mouse_handles[PS5_INPUT_INDEXES] = { -1, -1 };
+static bool keyboard_added, mouse_added;
+static bool keys_down[SDL_SCANCODE_COUNT];
+static Uint32 keyboard_modifiers;
+static Uint32 mouse_buttons;
+
+/* Text for the US layout, HID usages 0x04 (A) to 0x38 (/), unshifted and shifted. */
+static const char us_lower[] = "abcdefghijklmnopqrstuvwxyz1234567890\0\0\0\0 -=[]\\\0;'`,./";
+static const char us_upper[] = "ABCDEFGHIJKLMNOPQRSTUVWXYZ!@#$%^&*()\0\0\0\0 _+{}|\0:\"~<>?";
+SDL_COMPILE_TIME_ASSERT(ps5_us_layout, sizeof(us_lower) == sizeof(us_upper) && sizeof(us_lower) == 0x38 - 0x04 + 2);
+
+void PS5_InitKeyboardMouse(void)
+{
+    // Opened on the first pump: the user service may not be ready at VideoInit.
+    kbm_opened = false;
+}
+
+static void PS5_OpenKeyboardMouse(void)
+{
+    Sint32 user = -1;
+
+    kbm_opened = true;
+    if (sceUserServiceGetForegroundUser(&user) != 0 || user < 0) {
+        user = PS5_GetInitialUser();
+    }
+    if (user < 0) {
+        SDL_LogWarn(SDL_LOG_CATEGORY_INPUT, "PS5: no user for keyboard and mouse");
+        return;
+    }
+
+    if (sceSysmoduleLoadModule(PS5_SYSMODULE_KEYBOARD) >= 0 && sceKeyboardInit() >= 0) {
+        for (int i = 0; i < PS5_INPUT_INDEXES; i++) {
+            keyboard_handles[i] = sceKeyboardOpen(user, 0, i, NULL);
+        }
+    }
+    if (sceSysmoduleLoadModule(PS5_SYSMODULE_MOUSE) >= 0 && sceMouseInit() >= 0) {
+        for (int i = 0; i < PS5_INPUT_INDEXES; i++) {
+            Uint8 param[8] = { 0 };
+            mouse_handles[i] = sceMouseOpen(user, 0, i, param);
+        }
+    }
+    SDL_LogInfo(SDL_LOG_CATEGORY_INPUT, "PS5: keyboard handles %d %d, mouse handles %d %d",
+                keyboard_handles[0], keyboard_handles[1], mouse_handles[0], mouse_handles[1]);
+}
+
+void PS5_QuitKeyboardMouse(void)
+{
+    // The handles belong to the process and are released when the title ends.
+    if (keyboard_added) {
+        SDL_RemoveKeyboard(SDL_DEFAULT_KEYBOARD_ID);
+        keyboard_added = false;
+    }
+    if (mouse_added) {
+        SDL_RemoveMouse(SDL_DEFAULT_MOUSE_ID);
+        mouse_added = false;
+    }
+    SDL_zeroa(keys_down);
+    keyboard_modifiers = 0;
+    mouse_buttons = 0;
+}
+
+static void PS5_SendText(SDL_Window *window, SDL_Scancode scancode, Uint32 modifiers)
+{
+    char text[2] = { 0, 0 };
+    const int index = (int)scancode - SDL_SCANCODE_A;
+
+    if (!window || !SDL_TextInputActive(window) || (modifiers & (PS5_MODIFIER_CTRL | PS5_MODIFIER_ALT | PS5_MODIFIER_GUI))) {
+        return;
+    }
+    if (scancode >= SDL_SCANCODE_KP_DIVIDE && scancode <= SDL_SCANCODE_KP_PERIOD) {
+        text[0] = "/*-+\0" "1234567890."[scancode - SDL_SCANCODE_KP_DIVIDE];
+    } else if (index >= 0 && index < (int)sizeof(us_lower) - 1) {
+        bool shift = (modifiers & PS5_MODIFIER_SHIFT) != 0;
+        if ((SDL_GetModState() & SDL_KMOD_CAPS) && us_lower[index] >= 'a' && us_lower[index] <= 'z') {
+            shift = !shift;
+        }
+        text[0] = shift ? us_upper[index] : us_lower[index];
+    }
+    if (text[0]) {
+        SDL_SendKeyboardText(text);
+    }
+}
+
+static void PS5_HandleKeyboardRecord(const PS5_KeyboardRecord *record)
+{
+    bool now[SDL_SCANCODE_COUNT];
+    const Uint64 timestamp = SDL_GetTicksNS();
+    SDL_Window *window = SDL_GetKeyboardFocus();
+
+    if (!record->connected || record->intercepted) {
+        return;
+    }
+    if (!keyboard_added) {
+        SDL_AddKeyboard(SDL_DEFAULT_KEYBOARD_ID, "PS5 keyboard");
+        keyboard_added = true;
+    }
+
+    // Modifiers arrive as a bitmask, not as keycodes.
+    const Uint32 changed = record->modifiers ^ keyboard_modifiers;
+    for (int bit = 0; bit < 8; bit++) {
+        if (changed & (1u << bit)) {
+            const SDL_Scancode scancode = (SDL_Scancode)(SDL_SCANCODE_LCTRL + bit);
+            const bool down = (record->modifiers & (1u << bit)) != 0;
+            keys_down[scancode] = down;
+            SDL_SendKeyboardKey(timestamp, SDL_DEFAULT_KEYBOARD_ID, scancode, scancode, down);
+        }
+    }
+    keyboard_modifiers = record->modifiers;
+
+    SDL_zeroa(now);
+    for (int i = 0; i < 16; i++) {
+        const Uint16 usage = record->keycodes[i];
+        if (usage >= SDL_SCANCODE_A && usage < SDL_SCANCODE_COUNT) {
+            now[usage] = true;
+        }
+    }
+    for (int usage = SDL_SCANCODE_A; usage < SDL_SCANCODE_LCTRL; usage++) {
+        if (now[usage] != keys_down[usage]) {
+            keys_down[usage] = now[usage];
+            SDL_SendKeyboardKey(timestamp, SDL_DEFAULT_KEYBOARD_ID, usage, (SDL_Scancode)usage, now[usage]);
+            if (now[usage]) {
+                PS5_SendText(window, (SDL_Scancode)usage, keyboard_modifiers);
+            }
+        }
+    }
+}
+
+static void PS5_HandleMouseRecord(const PS5_MouseRecord *record)
+{
+    static const Uint8 sdl_buttons[5] = { SDL_BUTTON_LEFT, SDL_BUTTON_RIGHT, SDL_BUTTON_MIDDLE, SDL_BUTTON_X1, SDL_BUTTON_X2 };
+    const Uint64 timestamp = SDL_GetTicksNS();
+    SDL_Window *window = SDL_GetMouseFocus();
+
+    if (!record->connected || (record->buttons & PS5_MOUSE_INTERCEPTED)) {
+        return;
+    }
+    if (!mouse_added) {
+        SDL_AddMouse(SDL_DEFAULT_MOUSE_ID, "PS5 mouse");
+        mouse_added = true;
+    }
+
+    if (record->x || record->y) {
+        SDL_SendMouseMotion(timestamp, window, SDL_DEFAULT_MOUSE_ID, true, (float)record->x, (float)record->y);
+    }
+    const Uint32 changed = (record->buttons ^ mouse_buttons) & 0x1f;
+    for (int bit = 0; bit < 5; bit++) {
+        if (changed & (1u << bit)) {
+            SDL_SendMouseButton(timestamp, window, SDL_DEFAULT_MOUSE_ID, sdl_buttons[bit], (record->buttons & (1u << bit)) != 0);
+        }
+    }
+    mouse_buttons = record->buttons & 0x1f;
+    if (record->wheel || record->tilt) {
+        SDL_SendMouseWheel(timestamp, window, SDL_DEFAULT_MOUSE_ID, (float)record->tilt, (float)record->wheel, SDL_MOUSEWHEEL_NORMAL);
+    }
+}
+
+void PS5_PumpKeyboardMouse(SDL_VideoDevice *_this)
+{
+    if (!kbm_opened) {
+        PS5_OpenKeyboardMouse();
+    }
+    for (int i = 0; i < PS5_INPUT_INDEXES; i++) {
+        if (keyboard_handles[i] >= 0) {
+            PS5_KeyboardRecord records[16];
+            const int count = sceKeyboardRead(keyboard_handles[i], records, (int)SDL_arraysize(records));
+            for (int r = 0; r < count && r < (int)SDL_arraysize(records); r++) {
+                PS5_HandleKeyboardRecord(&records[r]);
+            }
+        }
+        if (mouse_handles[i] >= 0) {
+            PS5_MouseRecord records[64];
+            const int count = sceMouseRead(mouse_handles[i], records, (int)SDL_arraysize(records));
+            for (int r = 0; r < count && r < (int)SDL_arraysize(records); r++) {
+                PS5_HandleMouseRecord(&records[r]);
+            }
+        }
+    }
+}
+
+#endif // SDL_VIDEO_DRIVER_PS5
