+#ifdef SDL_JOYSTICK_PS5
+
+/* PlayStation 5 controllers through libScePad.
+ *
+ * The console pairs each controller with a signed-in user, and scePadOpen
+ * opens a user's controller; so a joystick here is a user's pad, up to four.
+ * The 120-byte sample layout and the call sequence are the ones
+ * PS5_VulkanTemplate, PS5_vkQuake and ProsperoLight read on hardware. */
+
+#include "../SDL_sysjoystick.h"
+#include "../usb_ids.h"
+#include "../../core/ps5/SDL_ps5.h"
+
+extern int scePadInit(void);
+extern int scePadOpen(Sint32 user_id, Sint32 port_type, Sint32 index, const void *params);
+extern int scePadGetHandle(Sint32 user_id, Sint32 port_type, Sint32 index);
+extern int scePadRead(Sint32 handle, void *samples, Sint32 capacity);
+extern int scePadClose(Sint32 handle);
+extern int scePadSetVibrationMode(Sint32 handle, Sint32 mode);
+extern int scePadSetVibration(Sint32 handle, const void *vibration);
+extern int scePadSetLightBar(Sint32 handle, const void *color);
+
+typedef struct PS5_PadSample
+{
+    Uint32 buttons;
+    Uint8 left_x, left_y, right_x, right_y, l2, r2; // 0..255; 128 is rest; y is down-positive
+    Uint8 reserved[66];
+    Sint32 connected;
+    Uint64 timestamp_us;
+    Uint8 extension[16];
+    Uint8 connected_count;
+    Uint8 remaining[15];
+} PS5_PadSample;
+
+SDL_COMPILE_TIME_ASSERT(ps5_pad_sample_size, sizeof(PS5_PadSample) == 120);
+SDL_COMPILE_TIME_ASSERT(ps5_pad_connected_offset, offsetof(PS5_PadSample, connected) == 0x4c);
+
+#define PS5_PAD_L3          0x000002
+#define PS5_PAD_R3          0x000004
+#define PS5_PAD_OPTIONS     0x000008
+#define PS5_PAD_UP          0x000010
+#define PS5_PAD_RIGHT       0x000020
+#define PS5_PAD_DOWN        0x000040
+#define PS5_PAD_LEFT        0x000080
+#define PS5_PAD_L1          0x000400
+#define PS5_PAD_R1          0x000800
+#define PS5_PAD_TRIANGLE    0x001000
+#define PS5_PAD_CIRCLE      0x002000
+#define PS5_PAD_CROSS       0x004000
+#define PS5_PAD_SQUARE      0x008000
+#define PS5_PAD_TOUCH_PAD   0x100000
+#define PS5_PAD_INTERCEPTED 0x80000000u // the shell has the pad (home screen, a system dialog)
+
+// The two-motor rumble (the other mode drives the DualSense's haptics).
+#define PS5_PAD_VIBRATION_COMPATIBLE 2
+
+// This driver's button numbering, in the order of the mapping below.
+static const Uint32 ps5_buttons[] = {
+    PS5_PAD_CROSS, PS5_PAD_CIRCLE, PS5_PAD_SQUARE, PS5_PAD_TRIANGLE,
+    PS5_PAD_OPTIONS, PS5_PAD_L3, PS5_PAD_R3, PS5_PAD_L1, PS5_PAD_R1,
+    PS5_PAD_UP, PS5_PAD_DOWN, PS5_PAD_LEFT, PS5_PAD_RIGHT, PS5_PAD_TOUCH_PAD
+};
+#define PS5_NUM_BUTTONS ((int)SDL_arraysize(ps5_buttons))
+#define PS5_NUM_AXES 6
+
+#define PS5_MAX_PADS 4
+#define PS5_SCAN_INTERVAL_MS 1000
+
+typedef struct PS5_Pad
+{
+    Sint32 user;
+    Sint32 handle;
+    SDL_JoystickID instance_id;
+    int player_index;
+} PS5_Pad;
+
+static PS5_Pad pads[PS5_MAX_PADS];
+static bool pad_service;
+static Uint64 next_scan;
+static Sint32 unopened_user = -1;
+
+static void PS5_RestPad(PS5_Pad *pad)
+{
+    pad->user = -1;
+    pad->handle = -1;
+    pad->instance_id = 0;
+    pad->player_index = -1;
+}
+
+static PS5_Pad *PS5_PadForDeviceIndex(int device_index)
+{
+    for (int i = 0; i < PS5_MAX_PADS; i++) {
+        if (pads[i].handle >= 0 && device_index-- == 0) {
+            return &pads[i];
+        }
+    }
+    return NULL;
+}
+
+static void PS5_OpenPad(int slot, Sint32 user)
+{
+    Sint32 handle = scePadOpen(user, 0, 0, NULL);
+    if (handle < 0) {
+        // A handle this process already holds for the user is reused.
+        handle = scePadGetHandle(user, 0, 0);
+    }
+    if (handle < 0) {
+        if (user != unopened_user) {
+            SDL_LogWarn(SDL_LOG_CATEGORY_INPUT, "PS5: scePadOpen failed for user %d: %#x", (int)user, (unsigned)handle);
+        }
+        unopened_user = user;
+        return;
+    }
+    SDL_LogInfo(SDL_LOG_CATEGORY_INPUT, "PS5: pad %d open for user %d (handle %d, rumble mode %#x)", slot, (int)user,
+                (int)handle, (unsigned)scePadSetVibrationMode(handle, PS5_PAD_VIBRATION_COMPATIBLE));
+    pads[slot].user = user;
+    pads[slot].handle = handle;
+    pads[slot].instance_id = SDL_GetNextObjectID();
+    pads[slot].player_index = slot;
+    SDL_PrivateJoystickAdded(pads[slot].instance_id);
+}
+
+static void PS5_ClosePad(int slot)
+{
+    if (pads[slot].handle < 0) {
+        return;
+    }
+    const SDL_JoystickID id = pads[slot].instance_id;
+    (void)scePadClose(pads[slot].handle);
+    PS5_RestPad(&pads[slot]);
+    SDL_PrivateJoystickRemoved(id);
+}
+
+/* The signed-in users again: a user who signed out lets their pad go, a new
+ * user's pad takes the first free slot, and the starting user keeps slot 0. */
+static void PS5_ScanPads(void)
+{
+    PS5_UserList list = { { -1, -1, -1, -1 } };
+    if (sceUserServiceGetLoginUserIdList(&list) < 0) {
+        return;
+    }
+    for (int slot = 0; slot < PS5_MAX_PADS; slot++) {
+        bool signed_in = false;
+        for (int i = 0; i < 4; i++) {
+            signed_in |= list.user_id[i] >= 0 && list.user_id[i] == pads[slot].user;
+        }
+        if (pads[slot].handle >= 0 && !signed_in) {
+            PS5_ClosePad(slot);
+        }
+    }
+    const Sint32 initial = PS5_GetInitialUser();
+    if (initial >= 0 && pads[0].handle < 0) {
+        PS5_OpenPad(0, initial);
+    }
+    for (int i = 0; i < 4; i++) {
+        const Sint32 user = list.user_id[i];
+        bool known = user < 0;
+        for (int slot = 0; slot < PS5_MAX_PADS && !known; slot++) {
+            known = pads[slot].handle >= 0 && pads[slot].user == user;
+        }
+        for (int slot = (user == initial) ? 0 : 1; slot < PS5_MAX_PADS && !known; slot++) {
+            if (pads[slot].handle < 0) {
+                PS5_OpenPad(slot, user);
+                break;
+            }
+        }
+    }
+}
+
+static bool PS5_JoystickInit(void)
+{
+    for (int i = 0; i < PS5_MAX_PADS; i++) {
+        PS5_RestPad(&pads[i]);
+    }
+    if (!PS5_InitUserService()) {
+        return SDL_SetError("PS5: no user service");
+    }
+    const int init = scePadInit();
+    SDL_LogInfo(SDL_LOG_CATEGORY_INPUT, "PS5: scePadInit %#x, initial user %d", (unsigned)init, (int)PS5_GetInitialUser());
+    if (init < 0) {
+        return SDL_SetError("PS5: scePadInit failed: %#x", (unsigned)init);
+    }
+    pad_service = true;
+    PS5_ScanPads();
+    next_scan = SDL_GetTicks() + PS5_SCAN_INTERVAL_MS;
+    return true;
+}
+
+static int PS5_JoystickGetCount(void)
+{
+    int count = 0;
+    for (int i = 0; i < PS5_MAX_PADS; i++) {
+        count += pads[i].handle >= 0;
+    }
+    return count;
+}
+
+static void PS5_JoystickDetect(void)
+{
+    // The pad service may publish a controller after the title starts, and users sign in and out.
+    if (pad_service && SDL_GetTicks() >= next_scan) {
+        PS5_ScanPads();
+        next_scan = SDL_GetTicks() + PS5_SCAN_INTERVAL_MS;
+    }
+}
+
+static bool PS5_JoystickIsDevicePresent(Uint16 vendor_id, Uint16 product_id, Uint16 version, const char *name)
+{
+    return false;
+}
+
+static const char *PS5_JoystickGetDeviceName(int device_index)
+{
+    return "DualSense Wireless Controller";
+}
+
+static const char *PS5_JoystickGetDevicePath(int device_index)
+{
+    return NULL;
+}
+
+static int PS5_JoystickGetDeviceSteamVirtualGamepadSlot(int device_index)
+{
+    return -1;
+}
+
+static int PS5_JoystickGetDevicePlayerIndex(int device_index)
+{
+    PS5_Pad *pad = PS5_PadForDeviceIndex(device_index);
+    return pad ? pad->player_index : -1;
+}
+
+static void PS5_JoystickSetDevicePlayerIndex(int device_index, int player_index)
+{
+    PS5_Pad *pad = PS5_PadForDeviceIndex(device_index);
+    if (pad) {
+        pad->player_index = player_index;
+    }
+}
+
+static SDL_GUID PS5_JoystickGetDeviceGUID(int device_index)
+{
+    // Sony's ids make SDL report the controller as a PS5 gamepad (button labels, type).
+    return SDL_CreateJoystickGUID(SDL_HARDWARE_BUS_USB, USB_VENDOR_SONY, USB_PRODUCT_SONY_DS5, 0,
+                                  NULL, "DualSense Wireless Controller", 0, 0);
+}
+
+static SDL_JoystickID PS5_JoystickGetDeviceInstanceID(int device_index)
+{
+    PS5_Pad *pad = PS5_PadForDeviceIndex(device_index);
+    return pad ? pad->instance_id : 0;
+}
+
+static bool PS5_JoystickOpen(SDL_Joystick *joystick, int device_index)
+{
+    PS5_Pad *pad = PS5_PadForDeviceIndex(device_index);
+    if (!pad) {
+        return SDL_SetError("PS5: no controller at index %d", device_index);
+    }
+    joystick->hwdata = (struct joystick_hwdata *)pad;
+    joystick->nbuttons = PS5_NUM_BUTTONS;
+    joystick->naxes = PS5_NUM_AXES;
+    joystick->nhats = 0;
+
+    SDL_PropertiesID props = SDL_GetJoystickProperties(joystick);
+    SDL_SetBooleanProperty(props, SDL_PROP_JOYSTICK_CAP_RUMBLE_BOOLEAN, true);
+    SDL_SetBooleanProperty(props, SDL_PROP_JOYSTICK_CAP_RGB_LED_BOOLEAN, true);
+    return true;
+}
+
+static PS5_Pad *PS5_PadForJoystick(SDL_Joystick *joystick)
+{
+    PS5_Pad *pad = (PS5_Pad *)joystick->hwdata;
+    return (pad && pad->handle >= 0 && pad->instance_id == joystick->instance_id) ? pad : NULL;
+}
+
+static bool PS5_JoystickRumble(SDL_Joystick *joystick, Uint16 low_frequency_rumble, Uint16 high_frequency_rumble)
+{
+    PS5_Pad *pad = PS5_PadForJoystick(joystick);
+    if (!pad) {
+        return SDL_SetError("PS5: controller is gone");
+    }
+    // The large motor is the low-frequency one.
+    const Uint8 motors[2] = { (Uint8)(low_frequency_rumble >> 8), (Uint8)(high_frequency_rumble >> 8) };
+    return scePadSetVibration(pad->handle, motors) >= 0 ? true : SDL_SetError("PS5: scePadSetVibration failed");
+}
+
+static bool PS5_JoystickRumbleTriggers(SDL_Joystick *joystick, Uint16 left_rumble, Uint16 right_rumble)
+{
+    return SDL_Unsupported();
+}
+
+static bool PS5_JoystickSetLED(SDL_Joystick *joystick, Uint8 red, Uint8 green, Uint8 blue)
+{
+    PS5_Pad *pad = PS5_PadForJoystick(joystick);
+    if (!pad) {
+        return SDL_SetError("PS5: controller is gone");
+    }
+    const Uint8 color[4] = { red, green, blue, 0 };
+    return scePadSetLightBar(pad->handle, color) >= 0 ? true : SDL_SetError("PS5: scePadSetLightBar failed");
+}
+
+static bool PS5_JoystickSendEffect(SDL_Joystick *joystick, const void *data, int size)
+{
+    return SDL_Unsupported();
+}
+
+static bool PS5_JoystickSetSensorsEnabled(SDL_Joystick *joystick, bool enabled)
+{
+    return SDL_Unsupported();
+}
+
+static Sint16 PS5_Axis(Uint8 value)
+{
+    // 0..255 onto the full range, 128 near 0, as SDL's HIDAPI driver reads the DualSense.
+    return (Sint16)((int)value * 257 - 32768);
+}
+
+static void PS5_SendSample(Uint64 timestamp, SDL_Joystick *joystick, const PS5_PadSample *sample)
+{
+    for (int i = 0; i < PS5_NUM_BUTTONS; i++) {
+        SDL_SendJoystickButton(timestamp, joystick, (Uint8)i, (sample->buttons & ps5_buttons[i]) != 0);
+    }
+    SDL_SendJoystickAxis(timestamp, joystick, 0, PS5_Axis(sample->left_x));
+    SDL_SendJoystickAxis(timestamp, joystick, 1, PS5_Axis(sample->left_y));
+    SDL_SendJoystickAxis(timestamp, joystick, 2, PS5_Axis(sample->right_x));
+    SDL_SendJoystickAxis(timestamp, joystick, 3, PS5_Axis(sample->right_y));
+    SDL_SendJoystickAxis(timestamp, joystick, 4, PS5_Axis(sample->l2));
+    SDL_SendJoystickAxis(timestamp, joystick, 5, PS5_Axis(sample->r2));
+}
+
+static void PS5_JoystickUpdate(SDL_Joystick *joystick)
+{
+    static PS5_PadSample samples[64];
+    PS5_Pad *pad = PS5_PadForJoystick(joystick);
+    if (!pad) {
+        return;
+    }
+    const int count = scePadRead(pad->handle, samples, (Sint32)SDL_arraysize(samples));
+    const Uint64 timestamp = SDL_GetTicksNS();
+    // The first reading, and each change between reading and failing, for the log.
+    static int last_logged = -2;
+    if ((count < 0) != (last_logged < 0) || last_logged == -2) {
+        if (count > 0) {
+            SDL_LogInfo(SDL_LOG_CATEGORY_INPUT, "PS5: scePadRead %d samples, connected %d, buttons %#x",
+                        count, (int)samples[count - 1].connected, (unsigned)samples[count - 1].buttons);
+        } else if (count < 0) {
+            SDL_LogWarn(SDL_LOG_CATEGORY_INPUT, "PS5: scePadRead failed: %#x", (unsigned)count);
+        }
+        last_logged = count > 0 ? count : (count < 0 ? -1 : last_logged);
+    }
+    // Every reading since the last poll, oldest first, so a tap shorter than a frame is seen.
+    for (int i = 0; i < count && i < (int)SDL_arraysize(samples); i++) {
+        if (samples[i].connected && !(samples[i].buttons & PS5_PAD_INTERCEPTED)) {
+            PS5_SendSample(timestamp, joystick, &samples[i]);
+        }
+    }
+}
+
+static void PS5_JoystickClose(SDL_Joystick *joystick)
+{
+    // The pad stays open with its user; the slot is released when the user signs out.
+    joystick->hwdata = NULL;
+}
+
+static void PS5_JoystickQuit(void)
+{
+    for (int slot = 0; slot < PS5_MAX_PADS; slot++) {
+        if (pads[slot].handle >= 0) {
+            (void)scePadClose(pads[slot].handle);
+        }
+        PS5_RestPad(&pads[slot]);
+    }
+    pad_service = false;
+}
+
+static bool PS5_JoystickGetGamepadMapping(int device_index, SDL_GamepadMapping *out)
+{
+    *out = (SDL_GamepadMapping){
+        .a = { EMappingKind_Button, 0 },
+        .b = { EMappingKind_Button, 1 },
+        .x = { EMappingKind_Button, 2 },
+        .y = { EMappingKind_Button, 3 },
+        .back = { EMappingKind_None, 255 },  // the Create button belongs to the shell
+        .guide = { EMappingKind_None, 255 }, // and so does the PS button
+        .start = { EMappingKind_Button, 4 },
+        .leftstick = { EMappingKind_Button, 5 },
+        .rightstick = { EMappingKind_Button, 6 },
+        .leftshoulder = { EMappingKind_Button, 7 },
+        .rightshoulder = { EMappingKind_Button, 8 },
+        .dpup = { EMappingKind_Button, 9 },
+        .dpdown = { EMappingKind_Button, 10 },
+        .dpleft = { EMappingKind_Button, 11 },
+        .dpright = { EMappingKind_Button, 12 },
+        .misc1 = { EMappingKind_None, 255 },
+        .misc2 = { EMappingKind_None, 255 },
+        .misc3 = { EMappingKind_None, 255 },
+        .misc4 = { EMappingKind_None, 255 },
+        .misc5 = { EMappingKind_None, 255 },
+        .misc6 = { EMappingKind_None, 255 },
+        .right_paddle1 = { EMappingKind_None, 255 },
+        .left_paddle1 = { EMappingKind_None, 255 },
+        .right_paddle2 = { EMappingKind_None, 255 },
+        .left_paddle2 = { EMappingKind_None, 255 },
+        .leftx = { EMappingKind_Axis, 0 },
+        .lefty = { EMappingKind_Axis, 1 },
+        .rightx = { EMappingKind_Axis, 2 },
+        .righty = { EMappingKind_Axis, 3 },
+        .lefttrigger = { EMappingKind_Axis, 4 },
+        .righttrigger = { EMappingKind_Axis, 5 },
+        .touchpad = { EMappingKind_Button, 13 },
+    };
+    return true;
+}
+
+SDL_JoystickDriver SDL_PS5_JoystickDriver = {
+    PS5_JoystickInit,
+    PS5_JoystickGetCount,
+    PS5_JoystickDetect,
+    PS5_JoystickIsDevicePresent,
+    PS5_JoystickGetDeviceName,
+    PS5_JoystickGetDevicePath,
+    PS5_JoystickGetDeviceSteamVirtualGamepadSlot,
+    PS5_JoystickGetDevicePlayerIndex,
+    PS5_JoystickSetDevicePlayerIndex,
+    PS5_JoystickGetDeviceGUID,
+    PS5_JoystickGetDeviceInstanceID,
+    PS5_JoystickOpen,
+    PS5_JoystickRumble,
+    PS5_JoystickRumbleTriggers,
+    PS5_JoystickSetLED,
+    PS5_JoystickSendEffect,
+    PS5_JoystickSetSensorsEnabled,
+    PS5_JoystickUpdate,
+    PS5_JoystickClose,
+    PS5_JoystickQuit,
+    PS5_JoystickGetGamepadMapping
+};
+
+#endif // SDL_JOYSTICK_PS5
