+  # PlayStation 5 homebrew: the payload SDK's toolchain file sets PS5. Video,
+  # controllers and sound go through the console's own services; the rest of
+  # SDL is the FreeBSD build.
+  if(PS5)
+    sdl_glob_sources(
+      "${SDL3_SOURCE_DIR}/src/core/ps5/*.c"
+      "${SDL3_SOURCE_DIR}/src/core/ps5/*.h"
