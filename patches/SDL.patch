+     in a product, an acknowledgment in the product documentation would be
+     appreciated but is not required.
+  2. Altered source versions must be plainly marked as such, and must not be
+     misrepresented as being the original software.
+  3. This notice may not be removed or altered from any source distribution.
+*/
+#include "SDL_internal.h"
+
+#ifdef SDL_AUDIO_DRIVER_PS5
+
+/* PlayStation 5 audio through libSceAudioOut: the system user's main port,
+ * 48 kHz interleaved stereo 16-bit, 256 frames a grain. sceAudioOutOutput
+ * blocks until the console takes the grain, which paces SDL's audio thread. */
+
+#include "../SDL_sysaudio.h"
+
+extern int sceAudioOutInit(void);
+extern int sceAudioOutOpen(Sint32 user, Sint32 type, Sint32 index, Uint32 grain, Uint32 rate, Uint32 format);
+extern int sceAudioOutOutput(Sint32 port, const void *samples);
+extern int sceAudioOutClose(Sint32 port);
+
+#define PS5AUDIO_DRIVER_NAME "ps5"
+#define PS5AUDIO_GRAIN 256
+#define PS5AUDIO_RATE 48000
+#define PS5AUDIO_SYSTEM_USER 0xff
+#define PS5AUDIO_PORT_MAIN 0
+#define PS5AUDIO_FORMAT_S16_STEREO 1
+#define PS5AUDIO_ALREADY_INITIALIZED ((int)0x8026000e)
+
+struct SDL_PrivateAudioData
+{
+    Sint32 port;
+    Uint8 *mixbuf;
+};
+
+static bool PS5AUDIO_OpenDevice(SDL_AudioDevice *device)
+{
+    device->hidden = (struct SDL_PrivateAudioData *)SDL_calloc(1, sizeof(*device->hidden));
+    if (!device->hidden) {
+        return false;
+    }
+    device->hidden->port = -1;
+
+    const int init = sceAudioOutInit();
+    if (init < 0 && init != PS5AUDIO_ALREADY_INITIALIZED) {
+        return SDL_SetError("sceAudioOutInit failed: 0x%08x", (unsigned)init);
+    }
+
+    // The one format the port takes; SDL converts whatever the application gives.
+    device->spec.format = SDL_AUDIO_S16LE;
+    device->spec.channels = 2;
+    device->spec.freq = PS5AUDIO_RATE;
+    device->sample_frames = PS5AUDIO_GRAIN;
+    SDL_UpdatedAudioDeviceFormat(device);
+
+    device->hidden->mixbuf = (Uint8 *)SDL_aligned_alloc(64, device->buffer_size);
+    if (!device->hidden->mixbuf) {
+        return false;
+    }
+    SDL_memset(device->hidden->mixbuf, device->silence_value, device->buffer_size);
+
+    device->hidden->port = sceAudioOutOpen(PS5AUDIO_SYSTEM_USER, PS5AUDIO_PORT_MAIN, 0, PS5AUDIO_GRAIN,
+                                           PS5AUDIO_RATE, PS5AUDIO_FORMAT_S16_STEREO);
+    if (device->hidden->port < 0) {
+        const int error = device->hidden->port;
+        device->hidden->port = -1;
+        return SDL_SetError("sceAudioOutOpen failed: 0x%08x", (unsigned)error);
+    }
+    return true;
+}
+
+static bool PS5AUDIO_WaitDevice(SDL_AudioDevice *device)
+{
+    // PlayDevice blocks for a grain; there is nothing else to wait for.
+    return true;
+}
+
+static bool PS5AUDIO_PlayDevice(SDL_AudioDevice *device, const Uint8 *buffer, int buflen)
+{
+    return sceAudioOutOutput(device->hidden->port, buffer) >= 0;
+}
+
+static Uint8 *PS5AUDIO_GetDeviceBuf(SDL_AudioDevice *device, int *buffer_size)
+{
+    return device->hidden->mixbuf;
+}
+
+static void PS5AUDIO_CloseDevice(SDL_AudioDevice *device)
+{
+    if (!device->hidden) {
+        return;
+    }
+    if (device->hidden->port >= 0) {
+        (void)sceAudioOutOutput(device->hidden->port, NULL); // drain the grain still queued
+        (void)sceAudioOutClose(device->hidden->port);
+    }
+    SDL_aligned_free(device->hidden->mixbuf);
+    SDL_free(device->hidden);
+    device->hidden = NULL;
+}
+
+static bool PS5AUDIO_Init(SDL_AudioDriverImpl *impl)
+{
+    impl->OpenDevice = PS5AUDIO_OpenDevice;
+    impl->WaitDevice = PS5AUDIO_WaitDevice;
+    impl->PlayDevice = PS5AUDIO_PlayDevice;
+    impl->GetDeviceBuf = PS5AUDIO_GetDeviceBuf;
+    impl->CloseDevice = PS5AUDIO_CloseDevice;
+    impl->OnlyHasDefaultPlaybackDevice = true;
+    impl->HasRecordingSupport = false;
+    return true;
+}
+
+AudioBootStrap PS5AUDIO_bootstrap = {
+    PS5AUDIO_DRIVER_NAME, "PlayStation 5 AudioOut",
+    PS5AUDIO_Init,
+    false,
+    false
+};
+
+#endif // SDL_AUDIO_DRIVER_PS5
