+*/
+#include "SDL_internal.h"
+
+#ifdef SDL_PLATFORM_PS5
+
+#include "SDL_ps5.h"
+
+static SDL_AtomicInt user_service_state; // 0 untouched, 1 ready, 2 failed
+static Sint32 initial_user = -1;
+
+bool PS5_InitUserService(void)
+{
+    if (SDL_GetAtomicInt(&user_service_state) == 0) {
+        // Already initialized by the title is fine; only the initial user matters.
+        const int init = sceUserServiceInitialize(NULL);
+        Sint32 user = -1;
+        const int got = sceUserServiceGetInitialUser(&user);
+        if (got < 0 || user < 0) {
+            SDL_LogError(SDL_LOG_CATEGORY_INPUT, "PS5: user service %#x, initial user %#x (%d)",
+                         (unsigned)init, (unsigned)got, (int)user);
+            SDL_SetAtomicInt(&user_service_state, 2);
+        } else {
+            initial_user = user;
+            SDL_SetAtomicInt(&user_service_state, 1);
+        }
+    }
+    return SDL_GetAtomicInt(&user_service_state) == 1;
+}
+
+Sint32 PS5_GetInitialUser(void)
+{
+    return PS5_InitUserService() ? initial_user : -1;
+}
+
+#endif // SDL_PLATFORM_PS5
