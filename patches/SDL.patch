diff --git a/src/filesystem/unix/SDL_sysfilesystem.c b/src/filesystem/unix/SDL_sysfilesystem.c
index 9edbf6dc0..51497bacf 100644
--- a/src/filesystem/unix/SDL_sysfilesystem.c
